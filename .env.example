# ResumeMatch 环境变量示例
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，禁止提交任何真实密钥。

# ---- 数据库 ----
# 默认写入 backend/data/resume_match.db，可用绝对路径覆盖
# DATABASE_URL=sqlite:///C:/Users/me/Desktop/resume-match-data/resume_match.db

# ---- 文件存储 ----
# 上传原件与导出产物的根目录，默认 backend/storage
# STORAGE_DIR=C:/Users/me/Desktop/resume-match-data/storage

# ---- 上传限制 ----
MAX_UPLOAD_MB=10

# ---- 导出（LibreOffice Headless）----
# 留空则自动在 PATH 与常见安装路径中查找 soffice
LIBREOFFICE_BIN=
LIBREOFFICE_TIMEOUT_SECONDS=120

# 启动时自动执行 alembic upgrade head
AUTO_MIGRATE=true

# ---- 模板构建 ----
# 参考简历原件路径（含个人信息，不入库），仅 build_template_from_resume.py 使用
REFERENCE_RESUME_PATH=

# ---- 模块 B 预留：分析提供方 ----
# mock | coze
ANALYSIS_PROVIDER=mock
# 以下两项只在 ANALYSIS_PROVIDER=coze 时需要，且只能放在本机 .env 中
COZE_BOT_ID=your-bot-id
COZE_API_TOKEN=your-api-token
